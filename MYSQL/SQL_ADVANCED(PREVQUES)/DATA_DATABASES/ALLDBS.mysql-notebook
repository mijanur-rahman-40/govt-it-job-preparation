    "content": "/*\n--- ECOMMERCE DB AND ITS TABLES\n*/\nDROP DATABASE IF EXISTS `Ecommerce`;\nCREATE DATABASE `Ecommerce`; \nUSE `Ecommerce`;\n\nSET NAMES UTF8;\nSET character_set_client = utf8mb4;\nCREATE TABLE `Ecommerce`.`Sales` (\n  `Sales_ID` INT NOT NULL,\n  `Sales_MAN` VARCHAR(200) NULL,\n  `Sales_REGION` VARCHAR(45) NULL,\n  `Sales_AMOUNT` INT NOT NULL,\n  `Sales_DATE` DATE NULL);\n\n  INSERT INTO Sales\nVALUES\n(1, 'David Parky',  'North',  70000, '2025-01-01'),\n(2, 'John Smith',   'South',  52000, '2025-01-03'),\n(3, 'Alex Brown',   'East',   84500, '2025-01-05'),\n(4, 'Michael Lee',  'West',   61000, '2025-01-07'),\n(5, 'Robert King',  'North',  93000, '2025-01-10');\n\n  \n/*\n--- PET SOCIETY DB AND ITS TABLES\n*/\n\nDROP DATABASE IF EXISTS `pet_society`;\nCREATE DATABASE `pet_society`; \nUSE `pet_society`;\n\nSET NAMES UTF8;\nSET character_set_client = utf8mb4;\n\nCREATE TABLE `pet_society`.`Animals` (\n  `Animal_ID` INT NOT NULL,\n  `Name` VARCHAR(200) NULL,\n  `Prev_Owner` VARCHAR(45) NULL,\n  `Date_Admitted` DATE NULL);\n\nINSERT INTO `Animals` \nVALUES\n(1,'Cow_123','David Parky','01-01-2025'),\n(12,'Goat_23','David Parky','21-05-2025'),\n(13,'Goat_213','MonaParky','28-05-2025'),\n(14,'Dog_13','MonaParky','15-06-2025'),\n(10,'Hen_13','David Parky','11-09-2025');\n\nCREATE TABLE `pet_society`.`Adopter` (\n  `PSIN` INT NULL,\n  `Name` VARCHAR(45) NULL,\n  `Address` VARCHAR(45) NULL,\n  `Others_Animals` VARCHAR(45) NULL);\n",
